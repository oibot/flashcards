{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FEATURE_AUDIO_CREATION": "false"
      }
    },
    "ios-simulator": {
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_FEATURE_AUDIO_CREATION": "false"
      },
      "ios": {
        "buildConfiguration": "Release",
        "simulator": true
      }
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://tobio-flashcards--preview.expo.app",
        "EXPO_PUBLIC_FEATURE_AUDIO_CREATION": "false"
      },
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FEATURE_AUDIO_CREATION": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
