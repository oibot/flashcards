{
  "name": "flashcards",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier . --write",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch --coverage=false --changedSince=origin/main",
    "testDebug": "jest -o --watch --coverage=false",
    "testFinal": "jest"
  },
  "dependencies": {
    "@expo/ui": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@instantdb/admin": "^1.0.11",
    "@instantdb/react-native": "^0.22.145",
    "@instantdb/react-native-mmkv": "^0.22.145",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "expo": "~55.0.17",
    "expo-asset": "~55.0.16",
    "expo-audio": "~55.0.14",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-router": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "i18next": "^25.8.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.83.6",
    "react-native-enriched": "^0.5.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.9",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-unistyles": "^3.0.24",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/.agents/**",
      "!**/.codex/**"
    ]
  }
}
