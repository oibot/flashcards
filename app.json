{
  "expo": {
    "name": "flashcards",
    "slug": "flashcards",
    "scheme": "flashcards",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tobio.flashcards",
      "icon": "./assets/icon/flashcards.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tobio.flashcards"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-localization",
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-audio",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "114b7876-f9a9-4d5f-a80d-7c1b0a3b8b3f"
      }
    }
  }
}
